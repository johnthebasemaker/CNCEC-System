# Build context hygiene — keep the image small and never bake local state in.
# NOTE: USER_MANUAL.md, the seed .xlsx files, and logos are NOT ignored —
# the app + RAG sidecar + SME bootstrap read them at runtime.

# Virtual envs / VCS
.venv/
venv/
env/
.git/
.gitignore

# Python cache
__pycache__/
*.pyc
*.pyo

# Local database + backups (lives in the gi-data named volume at runtime).
# `**/` because .dockerignore patterns are anchored at the context root, so a
# bare `*.db` would miss a nested one. gi_database.db is named explicitly: it is
# the live legacy system of record and must never enter an image layer.
*.db
**/*.db
gi_database.db
*.sqlite3
**/*.sqlite3
*.bak
**/*.bak
gi_database.*.bak

# Mutable disk state (mounted as volumes at runtime)
uploads/
data/cv_training/
models/
runs/
reports_archive/

# CV weights pulled separately into the gi-models volume
yolov8*.pt

# Reports / generated artifacts
BUG_REPORT.md
UI_CRAWLER_REPORT.md

# Secrets / env
.env
# Catches deploy/.env and any nested .env files
**/.env
# …and every .env VARIANT (.env.local, .env.production, …). The bare patterns
# above missed these, so an operator's .env.production would have been baked
# into the image. .env.example is the tracked template and stays available.
.env.*
**/.env.*
!.env.example
!**/.env.example
.streamlit/secrets.toml
# Key / certificate material (certbot output, local TLS experiments)
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.pfx
**/*.pfx

# OS noise
.DS_Store

# Docker meta (don't recurse the build files into the image)
docker-compose*.yml
Dockerfile*
.dockerignore

# Node / frontend build artifacts (images build these fresh)
**/node_modules/
frontend/dist/
