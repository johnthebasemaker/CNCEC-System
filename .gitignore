# Ignore virtual environments
.venv/
venv/
env/

# Ignore databases (Keep your local data local!)
*.db
*.sqlite3
*.db-wal
*.db-shm

# Explicit — do not rely on *.db glob for already-tracked files
/gi_database.db
/data-archive/gi_database.*.bak
/data-archive/*.db

# Ignore passwords/secrets
.env
# Every .env VARIANT (.env.local, .env.production, .env.staging …) — the
# audit (A04-F5) found only the bare `.env` covered, and `.env.production` is
# precisely the filename an operator creates while setting up the box.
# `.env.example` is the tracked template, so it is negated back in.
.env.*
!.env.example
.streamlit/secrets.toml
~$*.xlsx

# Key / certificate material. None exists in the tree today — this is
# preventive: certbot writes real private keys on the production host, and any
# local TLS experiment would otherwise drop an unignored .pem/.key here.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Loose backups and logs. `*.bak` is how data-archive/gi_database.*.bak came to
# be tracked in the first place (audit A04-C1).
*.bak
*.log

# Ignore Python cache clutter
__pycache__/
*.pyc

# Attachment store — DB BLOBs are authoritative; disk mirror is local-only.
uploads/

# Phase 6C — CV training artifacts (kept out of git; backed up separately)
models/
data/cv_training/
runs/
yolov8*.pt

# Runtime error logs (developer-facing; not source)
logs/
reports_archive/

# bin/dev.sh scratch: pidfiles + per-component logs for the local dev stack.
.dev/

# bin/backup_db.sh snapshots — pg_dump of `gihub` + a read-only copy of the
# frozen legacy SQLite. Local safety net only; these are full data dumps and
# must never reach the remote.
.backups/

# Live operational tracking workbooks (operator-owned, synced via
# tools/excel_sync.py — never commit; archived snapshots in data-archive/
# and legacy/scripts/sme_seed_data/ predate this rule and stay tracked).
*.xlsx

# HyperFrames tooling — vendored third-party skill packages, reinstallable with
# `npx skills add heygen-com/hyperframes`. Not part of this project's source.
/.agents/
/.claude/skills/
/skills-lock.json
/videos/*/.agents/
/videos/*/node_modules/
/videos/*/.hyperframes/
/videos/*/snapshots/
/videos/*/assets/vendor/

# Real PR/PO paperwork dropped in the repo root for OCR calibration
# (QSEP slice 6). These are genuine commercial documents — vendor names,
# prices, contacts — and are read locally to tune the parser, never
# committed. The manuals and SOP PDFs the API serves stay tracked, so the
# pattern is deliberately narrow rather than a blanket *.pdf.
/PO#*.pdf
/PR No *.pdf
