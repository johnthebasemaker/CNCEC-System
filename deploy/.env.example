# ============================================================================
# deploy/.env.example — copy to deploy/.env on the server and fill in.
# `deploy/.env` is gitignored (it holds secrets). NEVER commit the real one.
# ============================================================================

# --- Domain + TLS -----------------------------------------------------------
DOMAIN=erp.example.com
LETSENCRYPT_EMAIL=you@example.com
# Set to 1 for a dry run against Let's Encrypt staging (no rate limits) while
# you verify DNS/firewall; flip back to 0 for the real cert.
LETSENCRYPT_STAGING=0

# --- PostgreSQL (the system of record) --------------------------------------
POSTGRES_USER=gihub
POSTGRES_DB=gihub
# Use a long random password, e.g.  openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_long_random_password

# --- API auth ---------------------------------------------------------------
# Arms the JWT_SECRET production guard (config.py is_production()).
# Also required for Secure=True on refresh cookies (auth.py).
# Accepted values: "prod" or "production" (case-insensitive, trimmed).
GI_ENV=production
# MANDATORY in production: >= 32 chars, random. The API refuses to boot without
# a strong key (GI_ENV=production). Generate one:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32

# --- CORS (REQUIRED if you ship the native apps) ----------------------------
# ⚠️ CHANGED in Phase 2 Theme C (audit A04-F5/A03-F5). Previously an unset value
# fell back to a dev list that included http://localhost:5173, :3000 and bare
# http://localhost — as CREDENTIALED origins against the live API. In production
# an unset value now means NO cross-origin access at all.
#
#   * Browser-only deployment (nginx serves the SPA and proxies /api on the same
#     domain): leave BLANK. Same-origin needs no CORS.
#   * Desktop/mobile shells (Tauri/Capacitor) call the API cross-origin, so
#     their fixed webview origins MUST be listed here or every native API call
#     fails. These are not attacker-choosable values:
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,capacitor://localhost,https://localhost

# --- Rate-limit proxy trust -------------------------------------------------
# The limiter keys on CF-Connecting-IP / X-Real-IP. Those headers are
# attacker-supplied on any request that reaches the origin directly, and
# rotating one yields a fresh bucket per request — defeating the login,
# register, OTP and webhook-ban limiters at once (audit A03-F6).
#
# Set this to the peer address the API actually sees (the nginx container or the
# cloudflared tunnel endpoint) and the headers are trusted ONLY from there.
# Find it after the first deploy:
#     docker compose -f deploy/docker-compose.prod.yml logs api | head
#     # or: docker network inspect <net> | grep -A3 nginx
# Leave BLANK to keep the pre-Phase-2 behaviour (headers always trusted) — that
# is the safe default because a WRONG value keys every user onto one bucket and
# locks the whole site out of /auth/login.
GI_TRUSTED_PROXIES=

# --- WhatsApp Cloud API (Phase 7 — outbound notifications) ------------------
# Leave WHATSAPP_PHONE_NUMBER_ID / WHATSAPP_TOKEN blank to disable outbound
# WhatsApp (messages are still logged to the outbox as 'failed: not configured').
# Use a permanent System User token — never a temporary one.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_API_VERSION=v20.0
# Fallback recipient when a HOD/user has no Phone_Number on file (E.164, no '+').
WHATSAPP_ESCALATION_TO=
# Alert sends use APPROVED templates (deliverable outside the 24h window).
# Language for every template below (must match what you approve in Meta).
WHATSAPP_TEMPLATE_LANG=en
# Reusable notification templates (Phase 7c). Defaults match the names you must
# create + approve in WhatsApp Manager; override only if you approved different
# names. See docs/PROJECT_STATUS.md for the exact body text of each.
#   gi_action_required / gi_status_update / gi_critical_alert → TWO body vars {{1}} {{2}}
#   gi_otp_code                                               → ONE body var  {{1}} (Authentication)
WHATSAPP_TPL_ACTION=gi_action_required
WHATSAPP_TPL_STATUS=gi_status_update
WHATSAPP_TPL_CRITICAL=gi_critical_alert
WHATSAPP_TPL_OTP=gi_otp_code
#   gi_evening_summary → TWO body vars: {{1}} header (date + count), {{2}} the
#   compiled bullet digest (Phase 6 evening delivery preference).
WHATSAPP_TPL_SUMMARY=gi_evening_summary
# Inbound webhook (Phase 6). VERIFY_TOKEN: any random string — paste the same
# value in Meta's webhook subscription dialog (GET handshake). APP_SECRET: the
# Meta App Secret; when set, POST payloads are rejected unless their
# X-Hub-Signature-256 HMAC matches (leave blank only for local testing).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Legacy single-variable alert template (kept for back-compat send_text; unused
# by the current dispatch()-based triggers).
WHATSAPP_TEMPLATE_NAME=alert_notification

# --- SMTP email (Phase 7b — outbound alerts) ---------------------------------
# Leave SMTP_HOST blank to disable outbound email (messages still queue in the
# email_outbox as 'failed: not configured' and can be retried once configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER when blank.
SMTP_FROM=
# STARTTLS on by default; set 0 only for a plain-text relay on a trusted LAN.
SMTP_STARTTLS=1
# The logistics alert inbox (MTC-missing + vendor-return drafts land here).
EMAIL_LOGISTICS_TO=

# --- Off-box PostgreSQL backups to S3 (optional) ----------------------------
# The `backup` service dumps nightly to the pg-backups volume regardless. Set
# these to ALSO push each dump to S3 (leave AWS_S3_BUCKET blank = local-only).
# Use a dedicated IAM user scoped to put/list on this bucket only. Retention is
# a bucket lifecycle policy (e.g. 30d → Glacier, 90d → expire), not scripted.
AWS_S3_BUCKET=
AWS_S3_PREFIX=gihub
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SSE=AES256
